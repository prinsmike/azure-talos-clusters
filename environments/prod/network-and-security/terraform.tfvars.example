# prod / network-and-security — example variables.
# Copy to terraform.tfvars and fill in your own values. Never commit terraform.tfvars.

azure_subscription_id      = "00000000-0000-0000-0000-000000000000"
management_subscription_id = "" # subscription holding state storage / ACR / ops Key Vault

project        = "talos"
environment    = "prod"
location       = "eastus"
location_short = "eastus"

use_operations_key_vault            = false
operations_key_vault_name           = "kv-talos-ops"
operations_key_vault_resource_group = "rg-talos-ops"

enable_twingate  = false
management_cidrs = [] # e.g. ["10.10.0.0/24"]

# -----------------------------------------------------------------------------
# DNS — three-zone model (see docs/adr/0008-dns-delegated-self-service.md)
# -----------------------------------------------------------------------------

# 1. Public zones (security-owned; peer-reviewed). Configure your registrar with
#    the nameservers from the 'public_dns_zones_nameservers' output after apply.
public_dns_zones = [
  # {
  #   name = "example.com"
  #   a_records = [
  #     { name = "api", records = ["203.0.113.10"] },
  #     { name = "www", records = ["203.0.113.11"] },
  #   ]
  #   txt_records = [
  #     { name = "@", records = ["v=spf1 -all"] },
  #   ]
  # },
]

# 2. Internal apex private zone — security-owned top-level/infra records.
internal_apex_zone_name = "int.example.com"
internal_apex_a_records = [
  # { name = "api", records = ["10.200.1.10"] },
  # { name = "vault", records = ["10.200.1.20"] },
]
internal_apex_cname_records = []

# 3. Internal apps private zone — developer self-service via external-dns.
#    NO records are set here; external-dns creates them from Ingress/HTTPRoute
#    annotations. Leave empty to disable the zone.
internal_apps_zone_name = "apps.int.example.com"

# Managed identities for DNS.
#  - cert-manager: DNS-01 challenges on the PUBLIC zones (Let's Encrypt).
#  - external-dns: scoped (DNS Zone Contributor) to the apps zone ONLY.
enable_cert_manager_identity = true
enable_external_dns_identity = true

# Extra inbound NSG rules for the workers subnet (open ports declaratively).
custom_worker_ingress_rules = []
# e.g.
# custom_worker_ingress_rules = [{
#   name                    = "AllowAppP2P"
#   priority                = 200
#   direction               = "Inbound"
#   access                  = "Allow"
#   protocol                = "Tcp"
#   destination_port_ranges = ["30303"]
#   source_address_prefix   = "*"
# }]

enable_vwan_connection = false
vwan_hub_id            = ""

tags = {
  Project     = "talos-platform"
  CostCenter  = "platform-ops"
  Environment = "production"
  ManagedBy   = "terraform"
}
